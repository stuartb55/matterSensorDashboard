# Copy to .env and fill in. .env is gitignored and never baked into the image.
influxdb_token=
# InfluxDB's container name on docker_influxdb-network, or the host's address.
INFLUX_URL=http://influxdb:8181
# Optional: Philips Hue lights, read-only from the Hue Bridge's local API.
# HUE_BRIDGE is the bridge's LAN address. For HUE_APP_KEY, press the bridge's
# link button, then within 30 seconds run:
#   curl -k -X POST https://<bridge-address>/api -d '{"devicetype":"sensordashboard#server","generateclientkey":true}'
# and use the "username" it returns. Leave both empty to hide the Lights section.
HUE_BRIDGE=
HUE_APP_KEY=
# Optional: record each Hue room's on/off state into InfluxDB once a minute,
# so the Lights cards can show history. Needs a token that can write (and read)
# HUE_HISTORY_DB, separate from the read-only token above. Leave empty to skip.
HUE_HISTORY_TOKEN=
HUE_HISTORY_DB=hue
# Optional: outdoor temperature and humidity from Open-Meteo (free, no key) as
# a reference line on the charts. Two decimal places is plenty; leave both
# empty to hide it. Never sent to the browser.
WEATHER_LAT=
WEATHER_LON=
# Optional: electricity price per kWh, for costs on the energy meter's sheet,
# e.g. 0.245. ENERGY_CURRENCY is the symbol shown before amounts (default £).
ENERGY_PRICE=
ENERGY_CURRENCY=
# Optional: heating gas from the smart meter through Octopus Energy. The API
# key is under Personal details -> API access on octopus.energy; the account
# number looks like A-XXXXXXXX. Leave either empty to hide the gas panel. The
# meter point and serial are found from the account and never sent to the
# browser.
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT=
# m3 for SMETS2 gas meters (the usual case), kwh for SMETS1.
GAS_UNITS=m3
# MJ per m3 from your bill; 39.5 is typical. Used only when GAS_UNITS is m3.
GAS_CALORIFIC_VALUE=
# Leave empty to use the account's current Octopus gas tariff, or set both
# (per kWh and per day, including VAT, e.g. 0.0711 and 0.2903).
GAS_PRICE=
GAS_STANDING=
