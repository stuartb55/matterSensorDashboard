# Copy to .env and fill in. .env is gitignored and never baked into the image.
influxdb_token=
# InfluxDB's container name on docker_influxdb-network, or the host's address.
INFLUX_URL=http://influxdb:8181
# Optional: Philips Hue lights, read-only from the Hue Bridge's local API.
# HUE_BRIDGE is the bridge's LAN address. For HUE_APP_KEY, press the bridge's
# link button, then within 30 seconds run:
#   curl -k -X POST https://<bridge-address>/api -d '{"devicetype":"sensordashboard#server","generateclientkey":true}'
# and use the "username" it returns. Leave both empty to hide the Lights section.
HUE_BRIDGE=
HUE_APP_KEY=
